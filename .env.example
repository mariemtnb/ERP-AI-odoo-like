# Copy to .env and adjust. NEVER commit .env.

# --- PostgreSQL ---
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Laravel backend (reads DB_* / APP_*) ---
# Generate with: php artisan key:generate --show / php artisan jwt:secret --show
APP_KEY=
JWT_SECRET=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=change-me-strong-password

CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI service ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:32b
BACKEND_BASE_URL=http://backend:8000
AI_SERVICE_URL=http://ai-service:8001
AI_TIMEOUT=600

# --- Frontend (Vite reads VITE_* at build time) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

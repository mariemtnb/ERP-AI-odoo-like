@startuml use-case
' Who can do what. Grouped instead of listing every screen.
title Intelligent ERP — Who does what

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam actorStyle awesome
skinparam ArrowColor #6B7684
skinparam usecase {
  BorderColor #9AA5B1
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  BorderColor #C3CCD6
}

actor Employee as employee
actor Manager as manager
actor Administrator as admin
actor "Super admin" as superadmin
actor "Custom role\n(e.g. Cashier)" as custom
actor "Customer\n(portal, no login)" as buyer
actor "AI assistant" as agent <<system>>

manager --|> employee
admin --|> manager
superadmin --|> admin

rectangle "Intelligent ERP" {

  package "Everyone signed in" #F4FBF6 {
    usecase "Look up products,\ncustomers and stock" as UC1
    usecase "Create a sale" as UC2
    usecase "Add a customer\nor a lead" as UC3
    usecase "Ask the assistant" as UC4
    usecase "Edit own profile,\nchange password" as UC16
    usecase "Add notes &\nfollow-up activities" as UC21
  }

  package "Manager" #F7F4FB {
    usecase "Manage catalog\nand stock" as UC5
    usecase "Buy and receive\ngoods (partial OK)" as UC6
    usecase "Record cheques\nand traites" as UC7
    usecase "Set up instalment\nplans" as UC8
    usecase "Reconcile the bank" as UC9
    usecase "Read reports\nand the books" as UC10
    usecase "Run POS, HR,\nprojects, helpdesk…" as UC17
    usecase "Set pricelists\n& discounts" as UC22
    usecase "Record & 3-way\nmatch vendor bills" as UC23
    usecase "Run payroll\n(CNSS / IRPP)" as UC24
    usecase "File the VAT return" as UC25
    usecase "Email an invoice\nto the customer" as UC26
  }

  package "Administrator" #F4F8FB {
    usecase "Manage users" as UC11
    usecase "Configure company,\ntax and numbering" as UC12
    usecase "Switch modules\non and off" as UC13
    usecase "Read the audit trail" as UC14
    usecase "Approve large\npurchase orders" as UC15
  }

  package "Super admin" #FBF7F2 {
    usecase "Create custom roles\nand pick their modules" as UC18
    usecase "Grant / edit\nadmin accounts" as UC19
  }

  package "Custom role" #F2FBFA {
    usecase "Reach only the\nmodules granted\nto that role" as UC20
  }

  package "Customer portal" #FBF9F2 {
    usecase "View a shared\nquote or invoice" as UC27
    usecase "Pay online" as UC28
  }
}

employee --> UC1
employee --> UC2
employee --> UC3
employee --> UC4
employee --> UC16
employee --> UC21

manager --> UC5
manager --> UC6
manager --> UC7
manager --> UC8
manager --> UC9
manager --> UC10
manager --> UC17
manager --> UC22
manager --> UC23
manager --> UC24
manager --> UC25
manager --> UC26

admin --> UC11
admin --> UC12
admin --> UC13
admin --> UC14
admin --> UC15

superadmin --> UC18
superadmin --> UC19

custom --> UC20

buyer --> UC27
buyer --> UC28

' The assistant acts for a person, never beyond that person's rights.
' Two arrows, not one per use case — the rule is the same everywhere.
agent ..> UC1 : can read
agent ..> UC2 : can write,\nafter approval

note as N1 #FFFDF0
  The assistant works on behalf of the
  signed-in user, with exactly that
  user's permissions — so it can read
  and write whatever they could.
  Anything that changes data waits for
  the user to approve it first.
end note

note as N2 #F2FBFA
  A super admin builds a custom role and
  ticks the modules it may open (a Cashier
  might get Sales, POS and Inventory only).
  That allowlist is enforced in the sidebar,
  the route guard AND the API — the same
  boundary in all three places. Built-in
  roles are unchanged and see everything
  their level allows.
end note

@enduml

@startuml sequence-agent
title AI Agent — write action with human-in-the-loop confirmation

actor User
participant "Frontend\n(React)" as FE
participant "Backend\n(Laravel)" as BE
participant "AI Service\n(FastAPI + LangGraph)" as AI
participant "Ollama\n(qwen3:32b)" as LLM
database PostgreSQL as DB

User -> FE : "Crée un client nommé Fatma"
FE -> BE : POST /api/v1/agent/chat/ (JWT)
BE -> DB : store user message
BE -> AI : POST /chat {thread_id, message}\nAuthorization: user JWT

AI -> LLM : messages + tool schemas
LLM --> AI : tool_call create_customer(...)
note over AI : write tool → interrupt()\ngraph state checkpointed
AI --> BE : {type: confirmation_required, action}
BE -> DB : store pending_action message
BE --> FE : confirmation card
FE --> User : Approve / Reject ?

User -> FE : Approve
FE -> BE : POST /agent/chat/ {approve: true}
BE -> AI : POST /resume {thread_id, approved}
note over AI : graph resumes inside the tool
AI -> BE : POST /api/v1/customers/\n(user's JWT — RBAC enforced)
BE -> DB : INSERT customer
BE --> AI : 201 {id, name, ...}
AI -> LLM : tool result
LLM --> AI : final answer
AI --> BE : {type: message, reply, tool_calls}
BE -> DB : store reply + audit_logs (actor=agent)
BE --> FE : assistant message
FE --> User : "Client Fatma créé (ID 2)"

@enduml

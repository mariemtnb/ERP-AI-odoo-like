@startuml erd
' Database structure. Only the columns that explain the model are shown —
' every table also has id, created_at and updated_at.
title Intelligent ERP — Database structure

hide circle
hide empty members
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #6B7684
skinparam entity {
  BorderColor #9AA5B1
  BackgroundColor #FFFFFF
}
skinparam package {
  BorderColor #C3CCD6
  FontStyle bold
}

package "Company & access" #F4F8FB {
  entity companies {
    code, name
    currency, timezone
  }
  entity branches {
    code, name
  }
  entity fiscal_years {
    starts_on, ends_on
    status (open | closed)
  }
  entity numbering_sequences {
    key, format
    next_number
  }
  entity users {
    email, password
    role, is_active
  }
  entity roles {
    key, parent_id
  }
  entity permissions {
    key (e.g. sales.confirm)
  }
  entity audit_entries {
    event, who, when
    old / new values
  }
  entity feature_flags {
    key, enabled
  }
}

package "Catalog & stock" #F4FBF6 {
  entity categories {
    name
  }
  entity products {
    sku, name
    cost_price, sale_price
    quantity_in_stock
  }
  entity warehouses {
    name
  }
  entity warehouse_stocks {
    quantity
  }
  entity stock_movements {
    type (in | out | adjust)
    quantity, reason
  }
}

package "Partners & CRM" #FBF7F2 {
  entity customers {
    name, phone
  }
  entity suppliers {
    name, phone
  }
  entity leads {
    name, status
  }
  entity lead_activities {
    type, summary
  }
}

package "Sales & purchasing" #F7F4FB {
  entity sales {
    number, status
    total_amount
  }
  entity sale_lines {
    quantity, unit_price
  }
  entity purchase_orders {
    number, status
    total_amount
  }
  entity purchase_order_lines {
    quantity, unit_price
  }
  entity invoices {
    number
  }
}

package "Accounting" #FBF4F4 {
  entity accounts {
    code, name, type
  }
  entity journals {
    code (VT, AC, BQ, CH...)
  }
  entity journal_entries {
    number, entry_date
  }
  entity journal_entry_lines {
    debit, credit
  }
  entity account_mappings {
    key -> account_code
  }
}

package "Treasury (Tunisia)" #F2F8FB {
  entity payment_instruments {
    kind (cheque | traite)
    amount, due_date
    status
  }
  entity instrument_events {
    event, status change
  }
  entity installment_plans {
    number, total_amount
  }
  entity installments {
    due_date, amount
    paid_amount, status
  }
  entity payments {
    method, amount
  }
}

package "Banking" #F8FBF2 {
  entity banks {
    code, name
  }
  entity bank_accounts {
    label, rib
  }
  entity bank_transactions {
    date, label, amount
    status (matched?)
  }
  entity reconciliation_matches {
    amount
  }
}

package "AI assistant" #F9F2FB {
  entity conversations {
    title
  }
  entity messages {
    role, content
  }
  entity documents {
    title, content
    embedding (vector)
  }
}

' ---- company & access ----
companies ||--o{ branches
companies ||--o{ fiscal_years
companies ||--o{ numbering_sequences
roles ||--o{ roles : inherits
users }o--|| roles
roles }o--o{ permissions

' ---- catalog & stock ----
categories ||--o{ products
products ||--o{ stock_movements
products ||--o{ warehouse_stocks
warehouses ||--o{ warehouse_stocks

' ---- CRM ----
leads ||--o{ lead_activities
leads }o--o| customers : converts to

' ---- sales & purchasing ----
customers ||--o{ sales
sales ||--o{ sale_lines
sale_lines }o--|| products
sales ||--o| invoices
suppliers ||--o{ purchase_orders
purchase_orders ||--o{ purchase_order_lines
purchase_order_lines }o--|| products

' ---- accounting ----
journals ||--o{ journal_entries
journal_entries ||--o{ journal_entry_lines
journal_entry_lines }o--|| accounts
account_mappings }o--|| accounts

' ---- treasury ----
customers ||--o{ payment_instruments
payment_instruments ||--o{ instrument_events
installment_plans ||--o{ installments
customers ||--o{ installment_plans
payments }o--o| installments
payments }o--o| payment_instruments
payments }o--o| journal_entries : posts

' ---- banking ----
banks ||--o{ bank_accounts
bank_accounts ||--o{ bank_transactions
bank_accounts ||--o{ payment_instruments : deposited into
bank_transactions ||--o{ reconciliation_matches

' ---- AI ----
users ||--o{ conversations
conversations ||--o{ messages

' Documents also drive stock and the ledger, but those links are logical
' (reference_type + reference_id) rather than foreign keys. Drawing them
' turned the diagram into spaghetti, so they are written out instead —
' see sequence-sale-posting for how it actually runs.
note as N1 #FFFDF0
  **What triggers what**
  Confirming a sale       -> stock out + revenue entry
  Receiving a purchase    -> stock in  + payable entry
  Cheque changes status   -> its own entry each time
  Cancelling anything     -> an opposite entry, never a delete
end note

@enduml

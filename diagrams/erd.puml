@startuml erd
' Entity–Association diagram (database schema) — Intelligent ERP
title Intelligent ERP — Entity–Association Diagram

hide circle
skinparam linetype ortho

package "Identity & audit" {
  entity users {
    * id : bigint <<PK>>
    --
    * email : varchar <<unique>>
    * password : varchar
    first_name / last_name : varchar
    * role : varchar (admin|manager|employee)
    * is_active : boolean
    created_at / updated_at
  }

  entity audit_logs {
    * id : bigint <<PK>>
    --
    * user_id : bigint <<FK>>
    * actor : varchar (user|agent)
    * action : varchar
    payload : jsonb
    * created_at : timestamp
  }
}

package "Catalog & inventory" {
  entity categories {
    * id : bigint <<PK>>
    --
    * name : varchar <<unique>>
    description : text
  }

  entity products {
    * id : bigint <<PK>>
    --
    * sku : varchar <<unique>>
    * name : varchar
    category_id : bigint <<FK>>
    cost_price / sale_price : decimal(12,2)
    unit : varchar
    quantity_in_stock : decimal(12,3) <<global cache>>
    min_stock_level : decimal(12,3)
    * is_active : boolean
  }

  entity warehouses {
    * id : bigint <<PK>>
    --
    * name : varchar <<unique>>
    address : text
    * is_default : boolean
    * is_active : boolean
  }

  entity warehouse_stocks {
    * id : bigint <<PK>>
    --
    * warehouse_id : bigint <<FK>>
    * product_id : bigint <<FK>>
    * quantity : decimal(12,3)
    <<unique (warehouse_id, product_id)>>
  }

  entity stock_movements {
    * id : bigint <<PK>>
    --
    * product_id : bigint <<FK>>
    warehouse_id : bigint <<FK>>
    * movement_type : varchar (in|out|adjustment)
    * quantity : decimal(12,3)
    reason : varchar
    reference_type : varchar (sale|purchase|transfer|manual)
    reference_id : bigint
    * created_by : bigint <<FK users>>
    * created_at : timestamp
    ' append-only ledger: source of truth for stock
  }
}

package "Partners & CRM" {
  entity customers {
    * id : bigint <<PK>>
    --
    * name : varchar
    email / phone / address / notes
    * is_active : boolean
  }

  entity suppliers {
    * id : bigint <<PK>>
    --
    * name : varchar
    email / phone / address / notes
    * is_active : boolean
  }

  entity leads {
    * id : bigint <<PK>>
    --
    * name : varchar
    company / email / phone / source
    * status : varchar (new|contacted|qualified|won|lost)
    notes : text
    assigned_to : bigint <<FK users>>
    customer_id : bigint <<FK>> (set on conversion)
    * created_by : bigint <<FK users>>
  }

  entity lead_activities {
    * id : bigint <<PK>>
    --
    * lead_id : bigint <<FK>>
    * type : varchar (call|email|meeting|note)
    * summary : text
    * created_by : bigint <<FK users>>
    * created_at : timestamp
  }
}

package "Documents" {
  entity purchase_orders {
    * id : bigint <<PK>>
    --
    * number : varchar <<unique>> (PO-YYYY-NNNN)
    * supplier_id : bigint <<FK>>
    * status : varchar (draft|pending_approval|confirmed|received|cancelled)
    * order_date : date
    received_date : date
    * total_amount : decimal(14,2)
    approved_by : bigint <<FK users>>
    approved_at : timestamp
    * created_by : bigint <<FK users>>
  }

  entity purchase_order_lines {
    * id : bigint <<PK>>
    --
    * purchase_order_id : bigint <<FK>>
    * product_id : bigint <<FK>>
    * quantity : decimal(12,3)
    * unit_price : decimal(12,2)
  }

  entity sales {
    * id : bigint <<PK>>
    --
    * number : varchar <<unique>> (SO-YYYY-NNNN)
    * customer_id : bigint <<FK>>
    * status : varchar (draft|confirmed|cancelled)
    * sale_date : date
    * total_amount : decimal(14,2)
    * created_by : bigint <<FK users>>
  }

  entity sale_lines {
    * id : bigint <<PK>>
    --
    * sale_id : bigint <<FK>>
    * product_id : bigint <<FK>>
    * quantity : decimal(12,3)
    * unit_price : decimal(12,2)
  }

  entity invoices {
    * id : bigint <<PK>>
    --
    * number : varchar <<unique>> (INV-YYYY-NNNN)
    * sale_id : bigint <<FK, unique>> (1–1)
    * issued_at : timestamp
  }
}

package "Accounting (double-entry)" {
  entity accounts {
    * id : bigint <<PK>>
    --
    * code : varchar <<unique>> (1000, 1100, …)
    * name : varchar
    * type : varchar (asset|liability|equity|income|expense)
    * is_active : boolean
  }

  entity journal_entries {
    * id : bigint <<PK>>
    --
    * number : varchar <<unique>> (JE-YYYY-NNNN)
    * entry_date : date
    memo : varchar
    reference_type : varchar (sale|purchase|manual)
    reference_id : bigint
    * created_by : bigint <<FK users>>
    ' append-only: cancellations post a reversal
  }

  entity journal_entry_lines {
    * id : bigint <<PK>>
    --
    * journal_entry_id : bigint <<FK>>
    * account_id : bigint <<FK>>
    label : varchar
    * debit : decimal(14,2)
    * credit : decimal(14,2)
    ' invariant: SUM(debit) = SUM(credit) per entry
  }
}

package "AI assistant" {
  entity conversations {
    * id : bigint <<PK>>
    --
    * user_id : bigint <<FK>>
    title : varchar
    * created_at : timestamp
  }

  entity messages {
    * id : bigint <<PK>>
    --
    * conversation_id : bigint <<FK>>
    * role : varchar (user|assistant)
    content : text
    tool_calls : jsonb
    pending_action : jsonb
  }

  entity documents {
    * id : bigint <<PK>>
    --
    * title : varchar
    * chunk_index : int
    * content : text
    embedding : vector(768) <<pgvector>>
    * created_by : bigint <<FK users>>
  }
}

' ---- relationships ----
categories ||--o{ products
products ||--o{ stock_movements
products ||--o{ warehouse_stocks
warehouses ||--o{ warehouse_stocks
warehouses ||--o{ stock_movements
products ||--o{ purchase_order_lines
products ||--o{ sale_lines
suppliers ||--o{ purchase_orders
purchase_orders ||--o{ purchase_order_lines
customers ||--o{ sales
sales ||--o{ sale_lines
sales ||--o| invoices
customers ||--o| leads
leads ||--o{ lead_activities
accounts ||--o{ journal_entry_lines
journal_entries ||--o{ journal_entry_lines
users ||--o{ stock_movements : created_by
users ||--o{ purchase_orders : created_by
users ||--o{ purchase_orders : approved_by
users ||--o{ sales : created_by
users ||--o{ journal_entries : created_by
users ||--o{ leads : assigned_to
users ||--o{ conversations
users ||--o{ documents
conversations ||--o{ messages
users ||--o{ audit_logs

' ---- document → ledger links (logical, via reference_type/reference_id) ----
sales ..> stock_movements : "OUT on confirm"
purchase_orders ..> stock_movements : "IN on receipt"
sales ..> journal_entries : "revenue + COGS on confirm"
purchase_orders ..> journal_entries : "inventory + payable on receipt"

@enduml
